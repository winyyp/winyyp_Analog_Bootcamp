** sch_path: /home/winyzwsl/winyyp_Analog_Bootcamp/analog/bootcamp_opamp/schematics/opamp_two_stage_tb.sch
**.subckt opamp_two_stage_tb VOUT
*.ipin VOUT
VDD net6 GND 1.8
VSS net1 GND 0
VCM net5 GND 0.9
VDIFF net4 net2 0
R1 net2 net5 1meg m=1
R2 net3 net5 1meg m=1
x1 net6 VOUT net4 net3 net1 opamp_two_stage
**** begin user architecture code


.op
.control
op
print v(vout) i(vdd)
let pwr = 1.8*abs(i(vdd))
print pwr
dc VDIFF -0.02 0.02 0.0001
let gain = deriv(v(vout))
let gdb = 20*log10(maximum(abs(gain)))
print gdb
meas dc vos when v(vout)=0.9
plot v(vout)
.endc


.param mc_mm_switch=0
.param mc_pr_switch=0
.include /home/winyzwsl/.volare/sky130A/libs.tech/ngspice/corners/tt.spice
.include /home/winyzwsl/.volare/sky130A/libs.tech/ngspice/r+c/res_typical__cap_typical.spice
.include /home/winyzwsl/.volare/sky130A/libs.tech/ngspice/r+c/res_typical__cap_typical__lin.spice
.include /home/winyzwsl/.volare/sky130A/libs.tech/ngspice/corners/tt/specialized_cells.spice

